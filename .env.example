# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Required. Server-side only; this must never be exposed to the browser.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Use a different model for every request. Leave unset for the default,
# anthropic/claude-haiku-4.5 (about $0.002 a rewrite).
#
# Every request asks OpenRouter to use only zero-data-retention providers, which
# is a promise the site makes to its visitors (see /about). So a model with no
# such provider, which includes many free ones, should fail rather than quietly
# keep prompts. Don't set this to a model that logs or trains on what it receives.
# OPENROUTER_MODEL=

# Optional. Your public site URL, sent to OpenRouter for attribution.
# Defaults to http://localhost:3000 when unset.
SITE_URL=https://your-domain.com

# No database. This site stores no prompts or rewrites, by design, and says so on
# /about. Don't add storage keys here: see docs/2026-10-01-devils-advocate-review.md.
